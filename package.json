{
  "name": "azquiz-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:mobile": "npm run start -w @azquiz/mobile",
    "dev:api": "npm run dev -w @azquiz/api",
    "db:prepare": "node scripts/prepare-local-db.mjs",
    "generate": "npm run generate -w @azquiz/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages scripts --max-warnings 0",
    "format": "prettier --write apps packages scripts docs README.md README.az.md package.json tsconfig.base.json eslint.config.mjs",
    "format:check": "prettier --check apps packages scripts docs README.md README.az.md package.json tsconfig.base.json eslint.config.mjs",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "phone:link": "node scripts/phone-link.mjs",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "prettier": "^3.8.0",
    "qrcode": "^1.5.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true
  }
}
