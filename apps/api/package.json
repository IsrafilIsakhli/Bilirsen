{
  "name": "@azquiz/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env.local dist/apps/api/src/main.js",
    "typecheck": "tsc --noEmit",
    "generate": "prisma generate"
  },
  "dependencies": {
    "@azquiz/contracts": "*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.3.0",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "tsx": "^4.21.0",
    "@types/pg": "^8.15.0",
    "@types/express": "^5.0.0"
  }
}
